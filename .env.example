# Copy to .env.local — never commit real values.
# Vercel: Project Settings → Environment Variables

# Shopify app (Dev Dashboard → ReadyCounter → Settings → Credentials)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Production app URL (no trailing slash)
SHOPIFY_APP_URL=https://tooltruth-webmcp.vercel.app

# OAuth scopes (read-only for readiness audit)
SHOPIFY_SCOPES=read_products,read_product_listings

# Dev store in your Partner org — client-credentials grant (same-org only)
SHOPIFY_DEV_SHOP=your-store.myshopify.com

# Optional: Catalog / UCP agent API (separate from Admin OAuth)
SHOPIFY_CATALOG_API_KEY=

# Upstash (Wave 1 — durable rooms + stores)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
