yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# api/**/*.js are committed on purpose: Vercel git deploys apply .vercelignore at clone time,
# which removes api/**/*.ts before the build, so bundle-api.mjs finds nothing and the deploy ships no functions.
# Rebuild with `npm run build` and commit the .js whenever a server .ts changes.
api/**/*.js.map
audits/*
!audits/STRANGER-PASS-*.md
!audits/SHARE-STRANGER-*.md
!audits/stranger-runs-*.md
*.local
.env
.env.*
!.env.example

